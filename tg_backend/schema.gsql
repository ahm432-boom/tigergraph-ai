USE GRAPH FraudInvestigation

// Drop everything to start fresh (for dev)
DROP ALL

// Vertex types
CREATE VERTEX Customer (PRIMARY_ID customer_id STRING) WITH primary_id_as_attribute="true"

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING, 
    card_network STRING, 
    card_type STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX Transaction (
    PRIMARY_ID txn_id STRING, 
    ts DATETIME, 
    amount DOUBLE, 
    channel STRING, 
    risk_score DOUBLE, 
    product_cd STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX DeviceProfile (
    PRIMARY_ID device_id STRING, 
    device_type STRING, 
    os STRING, 
    browser STRING, 
    screen STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_id STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX EmailDomain (
    PRIMARY_ID email_domain STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    narrative STRING
) WITH primary_id_as_attribute="true"

// Edge types
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card)
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction, ts DATETIME)
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile)
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion)
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction) // Chronological link
CREATE DIRECTED EDGE INVOLVES_TXN (FROM ClosedCase, TO Transaction)
CREATE DIRECTED EDGE CONNECTED_TO_CARD (FROM ClosedCase, TO Card)

// Create the Graph
CREATE GRAPH FraudInvestigation (
    Customer, Card, Transaction, DeviceProfile, BillingRegion, EmailDomain, ClosedCase,
    OWNS, MADE, FROM_DEVICE, BILLED_IN, PURCHASER_EMAIL, NEXT_TXN, INVOLVES_TXN, CONNECTED_TO_CARD
)
